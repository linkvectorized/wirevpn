{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wirevpn:harness:project.schema:1.0",
  "title": "WireVPN validated external project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "kind",
    "manifest_version",
    "product_baseline",
    "accepted_specification",
    "sources",
    "entrypoints",
    "embedded_payloads",
    "generated_artifacts",
    "allowed_roots",
    "denied_root_classes",
    "prohibited_input_classes",
    "bootstrap",
    "required_checks",
    "data_classes",
    "public_report_rules",
    "evidence_limits",
    "optional_capabilities"
  ],
  "properties": {
    "schema": {
      "const": "wirevpn.external-project-config/1.0"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "validated-external-project-configuration"
    },
    "manifest_version": {
      "$ref": "#/$defs/version"
    },
    "product_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit"],
      "properties": {
        "repository": {
          "const": "linkvectorized/wirevpn"
        },
        "branch": {
          "const": "main"
        },
        "commit": {
          "const": "01143e05ce105ab42fec5fd7b0bacaac49ad2405"
        }
      }
    },
    "accepted_specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "commit", "accepted_on"],
      "properties": {
        "path": {
          "const": "docs/specs/wirevpn-harness-audit-v1.md"
        },
        "bytes": {
          "const": 38336
        },
        "sha256": {
          "const": "d7e2bba1491c1cf7dcb0f7913bdf51ca116cc4a8d76fb970f1f5f04e7e11c2d5"
        },
        "commit": {
          "const": "d5dbe8378c813d1c687f75bfec8223cc5e5b3409"
        },
        "accepted_on": {
          "const": "2026-10-27"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceIdentity"
      }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entrypoint"
      }
    },
    "embedded_payloads": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/embeddedPayload"
      }
    },
    "generated_artifacts": {
      "type": "array",
      "minItems": 29,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/generatedArtifact"
      }
    },
    "allowed_roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "fixture", "vector", "output"],
      "properties": {
        "source": {
          "$ref": "#/$defs/allowedRoot"
        },
        "fixture": {
          "$ref": "#/$defs/allowedRoot"
        },
        "vector": {
          "$ref": "#/$defs/allowedRoot"
        },
        "output": {
          "$ref": "#/$defs/allowedRoot"
        }
      }
    },
    "denied_root_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/deniedRootClass"
      }
    },
    "prohibited_input_classes": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "real-configurations",
          "private-keys",
          "real-endpoints",
          "credentials",
          "host-inventory",
          "raw-terminal-or-ssh-material",
          "real-backups"
        ]
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "digest_algorithm",
        "recompute_before_use",
        "pending_update",
        "on_missing_or_mismatch",
        "artifacts"
      ],
      "properties": {
        "identity": {
          "const": "wirevpn-w1-bootstrap/1.0"
        },
        "digest_algorithm": {
          "const": "sha-256"
        },
        "recompute_before_use": {
          "const": true
        },
        "pending_update": {
          "const": "exact-content-only"
        },
        "on_missing_or_mismatch": {
          "const": "fail-closed"
        },
        "artifacts": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/versionedArtifact"
          }
        }
      }
    },
    "required_checks": {
      "type": "array",
      "minItems": 23,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/requiredCheck"
      }
    },
    "data_classes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class_id", "disposition"],
        "properties": {
          "class_id": {
            "enum": ["public", "internal", "restricted"]
          },
          "disposition": {
            "enum": [
              "eligible-for-reviewed-public-commit",
              "owner-only-unless-curated",
              "never-accepted-as-harness-input"
            ]
          }
        }
      }
    },
    "public_report_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curated_only",
        "raw_evidence_upload",
        "secret_canary_failure",
        "excluded_content"
      ],
      "properties": {
        "curated_only": {
          "const": true
        },
        "raw_evidence_upload": {
          "const": "denied"
        },
        "secret_canary_failure": {
          "const": "blocks-completion"
        },
        "excluded_content": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "real-local-paths",
              "real-hostnames",
              "real-endpoints",
              "credentials",
              "key-material",
              "sensitive-remote-payloads",
              "unsanitized-transcripts"
            ]
          }
        }
      }
    },
    "evidence_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "prohibited_claims"],
      "properties": {
        "scope": {
          "type": "array",
          "const": ["deterministic-project-evidence"]
        },
        "prohibited_claims": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "production-safety",
              "live-platform-proof",
              "runtime-governance",
              "generic-conformance",
              "tamper-proof-evidence"
            ]
          }
        }
      }
    },
    "optional_capabilities": {
      "type": "array",
      "maxItems": 0
    }
  },
  "allOf": [
    {"$ref": "#/$defs/requireWVH01"},
    {"$ref": "#/$defs/requireWVH02"},
    {"$ref": "#/$defs/requireWVH03"},
    {"$ref": "#/$defs/requireWVH04"},
    {"$ref": "#/$defs/requireWVH05"},
    {"$ref": "#/$defs/requireWVH06"},
    {"$ref": "#/$defs/requireWVH07"},
    {"$ref": "#/$defs/requireWVH08"},
    {"$ref": "#/$defs/requireWVH09"},
    {"$ref": "#/$defs/requireWVH10"},
    {"$ref": "#/$defs/requireWVA01"},
    {"$ref": "#/$defs/requireWVA12"},
    {"$ref": "#/$defs/requireWVA13"},
    {"$ref": "#/$defs/requireWVA14"},
    {"$ref": "#/$defs/requireWVA15"},
    {"$ref": "#/$defs/requireWVA16"},
    {"$ref": "#/$defs/requireWVA17"},
    {"$ref": "#/$defs/requireWVA19"},
    {"$ref": "#/$defs/requireWVA20"},
    {"$ref": "#/$defs/requireWVA21"},
    {"$ref": "#/$defs/requireWVA26"},
    {"$ref": "#/$defs/requireWVA27"},
    {"$ref": "#/$defs/requireWVA28"}
  ],
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9.][A-Za-z0-9._-]*(?:/[A-Za-z0-9.][A-Za-z0-9._-]*)*$"
    },
    "rootPath": {
      "anyOf": [
        {"const": "."},
        {"$ref": "#/$defs/safeRelativePath"}
      ]
    },
    "nullableSha256": {
      "anyOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "nullablePath": {
      "anyOf": [
        {"$ref": "#/$defs/safeRelativePath"},
        {"type": "null"}
      ]
    },
    "digestState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "state", "sha256"],
          "properties": {
            "algorithm": {"const": "sha-256"},
            "state": {"const": "pending-bootstrap"},
            "sha256": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "state", "sha256"],
          "properties": {
            "algorithm": {"const": "sha-256"},
            "state": {"const": "content-bound"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "bytes", "sha256", "origin"],
      "properties": {
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "role": {
          "enum": ["product-script", "documentation", "ignore-rules"]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "data_class"],
          "properties": {
            "repository": {"const": "linkvectorized/wirevpn"},
            "commit": {"const": "01143e05ce105ab42fec5fd7b0bacaac49ad2405"},
            "data_class": {"const": "public"}
          }
        }
      }
    },
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint_id", "source_path", "source_sha256", "interface"],
      "properties": {
        "entrypoint_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "source_path": {
          "enum": [
            "server_setup.sh",
            "adguard_setup.sh",
            "client_setup.sh",
            "mobile_peer.sh",
            "wirevpn.sh",
            "wirevpn-connect.sh"
          ]
        },
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "interface": {
          "enum": [
            "server-installation",
            "adguard-installation",
            "client-installation",
            "mobile-peer-management",
            "managed-cli",
            "boot-connector"
          ]
        }
      }
    },
    "embeddedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_id",
        "container_source_path",
        "payload_kind",
        "delimiter",
        "opening_line",
        "content_start_line",
        "content_end_line",
        "includes_final_newline",
        "content",
        "standalone_source_path",
        "standalone_sha256",
        "byte_equality_required",
        "baseline_byte_equal"
      ],
      "properties": {
        "payload_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "container_source_path": {
          "enum": ["client_setup.sh", "mobile_peer.sh"]
        },
        "payload_kind": {
          "enum": ["embedded-bash", "remote-bash", "embedded-python"]
        },
        "delimiter": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "opening_line": {"type": "integer", "minimum": 1},
        "content_start_line": {"type": "integer", "minimum": 2},
        "content_end_line": {"type": "integer", "minimum": 2},
        "includes_final_newline": {"const": true},
        "content": {"$ref": "#/$defs/contentIdentity"},
        "standalone_source_path": {"$ref": "#/$defs/nullablePath"},
        "standalone_sha256": {"$ref": "#/$defs/nullableSha256"},
        "byte_equality_required": {"type": "boolean"},
        "baseline_byte_equal": {
          "anyOf": [{"type": "boolean"}, {"type": "null"}]
        }
      }
    },
    "generatedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "source_path",
        "artifact_kind",
        "destination",
        "extraction",
        "source",
        "content",
        "expansion",
        "framing",
        "nested_payload_id"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "source_path": {
          "enum": [
            "server_setup.sh",
            "adguard_setup.sh",
            "client_setup.sh",
            "mobile_peer.sh",
            "wirevpn.sh",
            "wirevpn-connect.sh"
          ]
        },
        "artifact_kind": {
          "enum": ["wireguard-config", "wireguard-config-backup", "wireguard-key", "sysctl-fragment", "resolver-config", "adguard-json-request", "launchd-plist"]
        },
        "destination": {"type": "string", "minLength": 1},
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "delimiter",
            "source_start_line",
            "source_start_column",
            "source_end_line",
            "source_end_column",
            "content_start_line",
            "content_start_column",
            "content_end_line",
            "content_end_column",
            "includes_final_newline"
          ],
          "properties": {
            "kind": {
              "enum": ["heredoc", "echo-double-quoted", "shell-double-quoted-argument", "shell-single-quoted-argument", "printf-single-quoted-format", "command-output", "file-copy"]
            },
            "delimiter": {
              "anyOf": [{"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, {"type": "null"}]
            },
            "source_start_line": {"type": "integer", "minimum": 1},
            "source_start_column": {"type": "integer", "minimum": 1},
            "source_end_line": {"type": "integer", "minimum": 1},
            "source_end_column": {"type": "integer", "minimum": 1},
            "content_start_line": {"type": "integer", "minimum": 1},
            "content_start_column": {"type": "integer", "minimum": 1},
            "content_end_line": {"type": "integer", "minimum": 1},
            "content_end_column": {"type": "integer", "minimum": 1},
            "includes_final_newline": {
              "anyOf": [{"type": "boolean"}, {"type": "null"}]
            }
          }
        },
        "source": {"$ref": "#/$defs/contentIdentity"},
        "content": {"$ref": "#/$defs/contentIdentity"},
        "expansion": {"enum": ["literal", "shell-parameters", "printf-arguments", "command-output", "source-content"]},
        "framing": {"enum": ["complete-file", "append-fragment", "request-body"]},
        "nested_payload_id": {
          "anyOf": [{"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, {"type": "null"}]
        }
      }
    },
    "allowedRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_class", "path", "access", "data_class"],
      "properties": {
        "root_class": {
          "enum": ["canonical-source", "synthetic-fixture", "semantic-vector", "public-report"]
        },
        "path": {"$ref": "#/$defs/rootPath"},
        "access": {
          "enum": ["read-only", "generated-output-only"]
        },
        "data_class": {
          "enum": ["public", "internal"]
        }
      }
    },
    "deniedRootClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_id", "rule"],
      "properties": {
        "class_id": {
          "enum": [
            "real-runtime-configuration",
            "real-home-or-home-fallback",
            "live-system-service-roots",
            "live-wireguard-roots",
            "live-adguard-roots",
            "canonical-repository-as-sandbox",
            "filesystem-root-as-sandbox",
            "overlapping-or-aliased-evidence-roots",
            "symlink-or-path-escape"
          ]
        },
        "rule": {"const": "deny-and-fail-closed"}
      }
    },
    "versionedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "version", "digest"],
      "properties": {
        "artifact_id": {
          "enum": [
            "runner",
            "vector-bundle",
            "check-inventory",
            "toolchain",
            "project-schema",
            "checks-schema",
            "vector-schema"
          ]
        },
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "version": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*/[0-9]+\\.[0-9]+$"},
        "digest": {"$ref": "#/$defs/digestState"}
      }
    },
    "invalidationDependency": {
      "enum": [
        "product-sources",
        "accepted-specification",
        "runner",
        "vector-bundle",
        "check-inventory",
        "toolchain",
        "project-schema",
        "checks-schema",
        "vector-schema",
        "fixtures",
        "fake-model",
        "instrumentation-profile",
        "containment-profile",
        "schedules",
        "public-report-policy"
      ]
    },
    "requiredCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "invalidation_dependencies"],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^WV[AH]-[0-9]{2}$"
        },
        "invalidation_dependencies": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/invalidationDependency"}
        }
      }
    },
    "requireWVH01": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVH-01"}}}}}},
    "requireWVH02": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVH-02"}}}}}},
    "requireWVH03": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVH-03"}}}}}},
    "requireWVH04": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVH-04"}}}}}},
    "requireWVH05": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVH-05"}}}}}},
    "requireWVH06": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVH-06"}}}}}},
    "requireWVH07": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVH-07"}}}}}},
    "requireWVH08": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVH-08"}}}}}},
    "requireWVH09": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVH-09"}}}}}},
    "requireWVH10": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVH-10"}}}}}},
    "requireWVA01": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVA-01"}}}}}},
    "requireWVA12": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVA-12"}}}}}},
    "requireWVA13": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVA-13"}}}}}},
    "requireWVA14": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVA-14"}}}}}},
    "requireWVA15": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVA-15"}}}}}},
    "requireWVA16": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVA-16"}}}}}},
    "requireWVA17": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVA-17"}}}}}},
    "requireWVA19": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVA-19"}}}}}},
    "requireWVA20": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVA-20"}}}}}},
    "requireWVA21": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVA-21"}}}}}},
    "requireWVA26": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVA-26"}}}}}},
    "requireWVA27": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVA-27"}}}}}},
    "requireWVA28": {"type": "object", "properties": {"required_checks": {"contains": {"required": ["check_id"], "properties": {"check_id": {"const": "WVA-28"}}}}}}
  }
}

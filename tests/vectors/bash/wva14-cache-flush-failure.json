{
  "arguments": [
    "down"
  ],
  "baseline_observation": {
    "authority": "non-authoritative",
    "statement": "Baseline ignores dscacheutil failure and exits 0; this vector characterizes attempts without inventing a stronger cache guarantee."
  },
  "binding_id": "bash-wva14-cache-flush-failure",
  "commands": [
    {
      "argv": [
        "uname",
        "-s"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "Darwin\n"
    },
    {
      "argv": [
        "sudo",
        "launchctl",
        "list"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "sudo",
        "wg",
        "show"
      ],
      "exit": 1,
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "networksetup",
        "-listallnetworkservices"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "An asterisk (*) denotes that a network service is disabled.\nWi-Fi\n"
    },
    {
      "argv": [
        "networksetup",
        "-getdnsservers",
        "Wi-Fi"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "10.0.0.1\n"
    },
    {
      "argv": [
        "networksetup",
        "-setdnsservers",
        "Wi-Fi",
        "empty"
      ],
      "exit": 0,
      "state": [
        {
          "op": "set",
          "path": "dns.clear_attempted",
          "value": true
        },
        {
          "op": "set",
          "path": "dns.stale_remaining",
          "value": false
        },
        {
          "op": "set",
          "path": "dns.swept_server",
          "value": "10.0.0.1"
        }
      ],
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "dscacheutil",
        "-flushcache"
      ],
      "exit": 1,
      "state": [
        {
          "op": "set",
          "path": "dns.cache_flush_attempted",
          "value": true
        }
      ],
      "stderr": "synthetic cache flush failure\n",
      "stdout": ""
    },
    {
      "argv": [
        "killall",
        "-HUP",
        "mDNSResponder"
      ],
      "exit": 0,
      "state": [
        {
          "op": "set",
          "path": "dns.responder_flush_attempted",
          "value": true
        }
      ],
      "stderr": "",
      "stdout": ""
    }
  ],

  "baseline_observation": {
    "authority": "non-authoritative",
    "statement": "Baseline ignores both sysctl statuses, starts the tunnel with all IPv6 still enabled, and exits 0."
  },
  "binding_id": "bash-wva17-linux-sysctl-up-failure",
  "commands": [
    {
      "argv": [
        "uname",
        "-s"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "Linux\n"
    },
    {
      "argv": [
        "sudo",
        "wg",
        "show"
      ],
      "exit": 1,
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "sysctl",
        "-w",
        "net.ipv6.conf.all.disable_ipv6=1"
      ],
      "exit": 1,
      "stderr": "synthetic sysctl all failure\n",
      "stdout": ""
    },
    {
      "argv": [
        "sysctl",
        "-w",
        "net.ipv6.conf.default.disable_ipv6=1"
      ],
      "exit": 0,
      "state": [
        {
          "op": "set",
          "path": "ipv6.default",
          "value": 1
        }
      ],
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "sudo",
        "systemctl",
        "start",
        "wg-quick@client"
      ],
      "exit": 0,
      "state": [
        {
          "op": "set",
          "path": "tunnel.active",
          "value": true
        },
        {
          "by": 1,
          "op": "increment",
          "path": "activation.count"
        }
      ],
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "sleep",
        "2"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "curl",
        "-s",
        "--max-time",
        "10",
        "ifconfig.me"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "192.0.2.10\n"
    }
  ],

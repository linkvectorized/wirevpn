{
  "arguments": [
    "up"
  ],
  "baseline_observation": {
    "authority": "non-authoritative",
    "statement": "Baseline verifies 1.1.1.1 on the first dig call and reports the synthetic exit IP."
  },
  "binding_id": "bash-wva15-dns-health-success",
  "commands": [
    {
      "argv": [
        "uname",
        "-s"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "Darwin\n"
    },
    {
      "argv": [
        "sudo",
        "wg",
        "show"
      ],
      "exit": 1,
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "networksetup",
        "-listallnetworkservices"
      ],
      "exit": 0,
      "state": [
        {
          "by": 1,
          "op": "increment",
          "path": "services.enumerations"
        }
      ],
      "stderr": "",
      "stdout": "An asterisk (*) denotes that a network service is disabled.\nWi-Fi\n"
    },
    {
      "argv": [
        "networksetup",
        "-getinfo",
        "Wi-Fi"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "IPv6: Automatic\n"
    },
    {
      "argv": [
        "networksetup",
        "-setv6off",
        "Wi-Fi"
      ],
      "exit": 0,
      "state": [
        {
          "op": "set",
          "path": "ipv6.Wi-Fi",
          "value": "off"
        }
      ],
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "sudo",
        "@CASE@/opt/homebrew/bin/wg-quick",
        "up",
        "@CASE@/etc/wireguard/client.conf"
      ],
      "exit": 0,
      "state": [
        {
          "op": "set",
          "path": "tunnel.active",
          "value": true
        },
        {
          "by": 1,
          "op": "increment",
          "path": "activation.count"
        }
      ],
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "dig",
        "+short",
        "+time=3",
        "+tries=1",
        "@1.1.1.1",
        "google.com"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "192.0.2.53\n"
    },
    {
      "argv": [
        "curl",
        "-s",
        "--max-time",
        "10",
        "ifconfig.me"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "192.0.2.10\n"
    }
  ],
  "containment_profile": "wirevpn-darwin-seatbelt/1",
  "content_sha256": "e2b3cb56a4da6a32c124ac25919cad9746494beb21d132d95e6debdfaa395f50",
  "entrypoint": "wirevpn.sh",
  "initial_state": {
    "activation": {
      "count": 0
    },
    "dns": {
      "cache_flush_attempted": false,
      "cache_flush_verified": false,
      "clear_attempted": false,
      "responder_flush_attempted": false,
      "safe_rejection": false,
      "stale_remaining": true,
      "swept_server": null
    },
    "ipv6": {
      "Wi-Fi": "automatic"
    },
    "packages": {},
    "peers": {},
    "services": {
      "enumerations": 0
    },
    "tunnel": {
      "active": false
    },
    "virtual_time": {
      "seconds": 0
    }
  },
  "instrumentation_profile": "wirevpn-bash-instrumentation/1.0",
  "schema": "wirevpn.bash-execution-binding/1.0",
  "timeout_seconds": 10,
  "vector_id": "wva15-dns-health-success",
  "vector_sha256": "2eebe848804455569da9d0945da2485b63006e6e8fd82415946060c578303375"
}

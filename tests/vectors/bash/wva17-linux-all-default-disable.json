{
  "arguments": [
    "up"
  ],
  "baseline_observation": {
    "authority": "non-authoritative",
    "statement": "Baseline saves only proc all=0, writes all=1 and default=1, then starts the service."
  },
  "binding_id": "bash-wva17-linux-all-default-disable",
  "commands": [
    {
      "argv": [
        "uname",
        "-s"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "Linux\n"
    },
    {
      "argv": [
        "sudo",
        "wg",
        "show"
      ],
      "exit": 1,
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "sysctl",
        "-w",
        "net.ipv6.conf.all.disable_ipv6=1"
      ],
      "exit": 0,
      "state": [
        {
          "op": "set",
          "path": "ipv6.all",
          "value": 1
        }
      ],
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "sysctl",
        "-w",
        "net.ipv6.conf.default.disable_ipv6=1"
      ],
      "exit": 0,
      "state": [
        {
          "op": "set",
          "path": "ipv6.default",
          "value": 1
        }
      ],
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "sudo",
        "systemctl",
        "start",
        "wg-quick@client"
      ],
      "exit": 0,
      "state": [
        {
          "op": "set",
          "path": "tunnel.active",
          "value": true
        },
        {
          "by": 1,
          "op": "increment",
          "path": "activation.count"
        }
      ],
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "sleep",
        "2"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "curl",
        "-s",
        "--max-time",
        "10",
        "ifconfig.me"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "192.0.2.10\n"
    }
  ],
  "containment_profile": "wirevpn-darwin-seatbelt/1",
  "content_sha256": "2009e100f12ad16bf31ed06e4c6eb70f08b188ad67d13feda5c1752ac22f2bbb",
  "entrypoint": "wirevpn.sh",
  "initial_state": {
    "activation": {
      "count": 0
    },
    "dns": {},
    "ipv6": {
      "all": 0,
      "default": 0
    },
    "packages": {},
    "peers": {},
    "services": {},
    "tunnel": {
      "active": false
    },
    "virtual_time": {
      "seconds": 0
    }
  },
  "instrumentation_profile": "wirevpn-bash-instrumentation/1.0",
  "schema": "wirevpn.bash-execution-binding/1.0",
  "timeout_seconds": 10,
  "vector_id": "wva17-linux-all-default-disable",
  "vector_sha256": "43952bf9d03c91c1db684531b6c37d5d1a01b28099356735da77e791606dcddb"
}

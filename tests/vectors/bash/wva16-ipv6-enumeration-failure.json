{
  "arguments": [
    "up"
  ],
  "baseline_observation": {
    "authority": "non-authoritative",
    "statement": "Baseline treats failed enumeration as an empty list, removes the empty state file, and activates anyway."
  },
  "binding_id": "bash-wva16-ipv6-enumeration-failure",
  "commands": [
    {
      "argv": [
        "uname",
        "-s"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "Darwin\n"
    },
    {
      "argv": [
        "sudo",
        "wg",
        "show"
      ],
      "exit": 1,
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "networksetup",
        "-listallnetworkservices"
      ],
      "exit": 1,
      "state": [
        {
          "by": 1,
          "op": "increment",
          "path": "services.enumerations"
        }
      ],
      "stderr": "synthetic service enumeration failure\n",
      "stdout": "An asterisk (*) denotes that a network service is disabled.\n"
    },
    {
      "argv": [
        "sudo",
        "@CASE@/opt/homebrew/bin/wg-quick",
        "up",
        "@CASE@/etc/wireguard/client.conf"
      ],
      "exit": 0,
      "state": [
        {
          "op": "set",
          "path": "tunnel.active",
          "value": true
        },
        {
          "by": 1,
          "op": "increment",
          "path": "activation.count"
        }
      ],
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "dig",
        "+short",
        "+time=3",
        "+tries=1",
        "@10.0.0.1",
        "google.com"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "192.0.2.53\n"
    },
    {
      "argv": [
        "curl",
        "-s",
        "--max-time",
        "10",
        "ifconfig.me"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "192.0.2.10\n"
    }
  ],
  "containment_profile": "wirevpn-darwin-seatbelt/1",
  "content_sha256": "ffcce97facbd0feab20702f1360afde3aba9b67f2803bf4559d3b7c12a5b8775",
  "entrypoint": "wirevpn.sh",
  "initial_state": {

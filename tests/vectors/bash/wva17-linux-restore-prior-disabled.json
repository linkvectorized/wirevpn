{
  "arguments": [
    "down"
  ],
  "baseline_observation": {
    "authority": "non-authoritative",
    "statement": "Baseline restores both sysctls to 1."
  },
  "binding_id": "bash-wva17-linux-restore-prior-disabled",
  "commands": [
    {
      "argv": [
        "uname",
        "-s"
      ],
      "exit": 0,
      "stderr": "",
      "stdout": "Linux\n"
    },
    {
      "argv": [
        "sudo",
        "systemctl",
        "stop",
        "wg-quick@client"
      ],
      "exit": 0,
      "state": [
        {
          "by": 1,
          "op": "increment",
          "path": "services.stop_attempts"
        },
        {
          "op": "set",
          "path": "tunnel.active",
          "value": false
        }
      ],
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "sysctl",
        "-w",
        "net.ipv6.conf.all.disable_ipv6=1"
      ],
      "exit": 0,
      "state": [
        {
          "op": "set",
          "path": "ipv6.all",
          "value": 1
        }
      ],
      "stderr": "",
      "stdout": ""
    },
    {
      "argv": [
        "sysctl",
        "-w",
        "net.ipv6.conf.default.disable_ipv6=1"
      ],
      "exit": 0,
      "state": [
        {
          "op": "set",
          "path": "ipv6.default",
          "value": 1
        }
      ],
      "stderr": "",
      "stdout": ""
    }
  ],
  "containment_profile": "wirevpn-darwin-seatbelt/1",
  "content_sha256": "6c5085ebe5c39ed167008443baea5f3f085ee7fb9d450f0d4f9fb9574efde651",
  "entrypoint": "wirevpn.sh",
  "initial_state": {
    "dns": {},
    "ipv6": {
      "all": 1,
      "default": 1
    },
    "packages": {},
    "peers": {},
    "services": {
      "stop_attempts": 0
    },
    "tunnel": {
      "active": true
    },
    "virtual_time": {
      "seconds": 0
    }
  },
  "instrumentation_profile": "wirevpn-bash-instrumentation/1.0",
  "schema": "wirevpn.bash-execution-binding/1.0",
  "timeout_seconds": 10,
  "vector_id": "wva17-linux-restore-prior-disabled",
